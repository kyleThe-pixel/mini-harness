# Copy to .env and fill in. (Or paste the key in the web UI — it stays in your browser.)
OPENROUTER_API_KEY=
# Pooling: comma-separated keys, one per person/account. Requests rotate
# across keys; each key is paced and throttled independently.
# OPENROUTER_API_KEYS=sk-or-v1-aaa,sk-or-v1-bbb,sk-or-v1-ccc
# Optional overrides:
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# HARNESS_WORKSPACE=workspace
# HARNESS_DEFAULT_MODEL=qwen/qwen3-coder:free
# HARNESS_PROVIDER=openrouter   # or "local"
# HARNESS_LOCAL_URL=http://localhost:8080/v1
# HARNESS_LOCAL_MODEL=
